@Tutorial(time: 25, projectFiles: "bitcoin-key-tool.zip") {

    @XcodeRequirement(title: "Xcode 26", destination: "https://developer.apple.com/download/")

    @Intro(title: "Generating secret and public keys") {
        This tutorial guides you through building _Bitcoin Key Tool_ — a command-line utility for performing Bitcoin-related cryptographic operations. You’ll start by initializing a Swift Package with Argument Parser support and adding Swift Bitcoin as a dependency.

        In subsequent sections you will implement a subcommand for generating secret keys and another one for deriving public keys from those secret keys. As you add commands to the tool you will test them in the Terminal using the result of the first command as an argument for the second.

        You need a Swift Toolchain or Xcode installed in order to follow the steps below.

        @Image(source: SwiftBitcoinLogo, alt: "")
    }
        
    @Section(title: "Swift Package configuration") {

        @ContentAndMedia {
            Create a new Swift Package with an executable target that uses Swift Argument Parser.

            Use the `swift` command to initialize the project from the Terminal. Customize the package manifest in your favorite source code editor.
        }
            
        @Steps {

            Open a Terminal window to perform the following steps.

            @Step {
                Type `swift --version` into the terminal and verify that you have Swift version 6.2 or higher installed in your system.
                
                > Important: To install the latest Swift Toolchain for your platform go to  [swift.org/install](https://www.swift.org/install) and follow the instructions.

                @Image(source: c01-t01-s01-00, alt: "")
            }

            @Step {
                To create a directory named _keytool_ and change to it type: `mkdir keytool && cd keytool`. Then, initialize the package with `swift package init --type tool`.

                @Image(source: c01-t01-s01-01, alt: "")
            }

            @Step {
                Open and inspect `Package.swift` in your favorite editor or IDE.
                
                Notice how there's already an executable target with a dependency on the Argument Parser library.

                @Code(name: "Package.swift", file: c01-t01-s01-02-Package)
            }

            @Step {
                Clean up some unnecessary comments and rename the package `BitcoinKeyTool`.

                @Code(name: "Package.swift", file: c01-t01-s01-03-Package)
            }

            @Step {
                Add `https://github.com/swift-bitcoin/swift-bitcoin` as a package dependency and link the `Bitcoin` product to the executable target.

                > Important: If you're building for the Mac you need to specify the version of the platform which  must be macOS 26 or higher as per Swift Bitcoin requirements.

                @Code(name: "Package.swift", file: c01-t01-s01-04-Package)
            }
        }
    }

    @Section(title: "Root command") {

        @ContentAndMedia {
            Prepare the root command which is the main entry point for the tool.
        }

        @Steps {
            
            @Step {
                Inspect the generated `keytool.swift` containing the root command. The struct is annotated with `@main` to indicate it is the program's entry point.

                The placeholder implementation just prints a _Hello, World!_ message to the Terminal.

                @Code(name: "keytool.swift", file: c01-t01-s02-01-keytool)
            }

            @Step {
                Rename the struct `Keytool` and replace the `run()` function with a static `configuration` variable.
                
                The `Keytool` command will contain multiple subcommands.

                @Code(name: "Keytool.swift", file: c01-t01-s02-02-Keytool)
            }

            @Step {
                Create a new empty command named `GenerateSecretKey`.
                
                You will implement this command in the next tutorial.
                
                @Code(name: "GenerateSecretKey.swift", file: c01-t01-s02-03-GenerateSecretKey)
            }

            @Step {
                Add the new subcommand to the main command.

                @Code(name: "Keytool.swift", file: c01-t01-s02-04-Keytool)
            }

            @Step {
                Test the command by typing `swift run keytool` in the Terminal. Swift will compile the tool and run it.
                
                After a while you will see a help message with the `generate-secret-key` subcommand listed.

                @Image(source: c01-t01-s02-05, alt: "")
            }            
        }
    }

    @Section(title: "Generate a secret key") {

        @ContentAndMedia {
            Create a subcommand for generating secret keys. Add a second command to derive a public key from a secret key passed as argument.

            Use the Terminal to execute the tool and validate each operation as you implement them.

            @Image(source: c01-t01-s03, alt: "")
        }
            
        @Steps {
            
            Use the starting template in the sample code.
            
            @Step {
                Start by stubbing an empty `GenerateSecretKey` subcommand which takes no arguments or options. Calling this command will eventually output a new secret key.

                > Important: All subcommands must be added to the `Keytool` command configuration. 
                
                @Code(name: "GenerateSecretKey.swift", file: c01-t01-s03-01-GenerateSecretKey)
            }

            @Step {
                To use the available cryptographic functions, first import the `BitcoinCrypto` module.

                > Important: The Swift Bitcoin package must be added as a project dependency. Alternatively you can import the umbrella `Bitcoin` module which offers the entire Swift Bitcoin API.

                @Code(name: "GenerateSecretKey.swift", file: c01-t01-s03-02-GenerateSecretKey)
            }
            
            @Step {
                To generate a secret key simply instantiate `SecretKey`.
                
                @Code(name: "GenerateSecretKey.swift", file: c01-t01-s03-03-GenerateSecretKey)
            }
            
            @Step {
                The description of the newly generated secret key serializes it in hexadecimal format. Use string interpolation to include it in the output.
                
                @Code(name: "GenerateSecretKey.swift", file: c01-t01-s03-04-GenerateSecretKey)
            }

            For the next step open a Terminal window in the project's directory.

            @Step {
                Generate a secret key by running `swift run keytool generate-secret-key`.
                
                The newly generated secret key is displayed in serialized hexadecimal format.
                
                > Important: The actual output will be different as it is randomly generated. 
                
                @Image(source: c01-t01-s03-05, alt: "")
            }
            
            Leave the Terminal open as you will need it in the next section.
        }
    }

    @Section(title: "Derive a public key") {
        @ContentAndMedia {
            We are ready to derive a public key from a secret key.
            
            For this we will add a new command `derive-public-key`.

            @Image(source: c01-t01-s04, alt: "")
        }
            
        @Steps {
            
            @Step {
                Start by stubbing an empty `DerivePublicKey` subcommand.

                @Code(name: "DerivePublicKey.swift", file: c01-t01-s04-01-DerivePublicKey)
            }

            @Step {
                Declare a `String` argument for the serialized secret key.
                
                The secret key argument will be the hexadecimal string generated by `GenerateSecretKey`.

                @Code(name: "DerivePublicKey.swift", file: c01-t01-s04-02-DerivePublicKey)
            }

            @Step {
                Parse the hex string by initializing a `SecretKey`. If the serialized key cannot be parsed, throw a validation error.

                @Code(name: "DerivePublicKey.swift", file: c01-t01-s04-03-DerivePublicKey)
            }

            @Step {
                Get the public key from the secret key by simply accessing the `pubkey` property.

                @Code(name: "DerivePublicKey.swift", file: c01-t01-s04-04-DerivePublicKey)
            }

            @Step {
                Output the serialized public key using string interpolation.
                
                Public keys conform to the `CustomStringConvertible` protocol and their description is their serialized form as hex string.

                @Code(name: "DerivePublicKey.swift", file: c01-t01-s04-05-DerivePublicKey)
            }

            Go back to the Terminal where you executed the last command.

            @Step {
                Use the key generated in the previous step to derive a public key with `swift run keytool derive-public-key …`.
                
                > Important: You will need to use your own secret key as printed by the previous command.
                
                @Image(source: c01-t01-s04-06, alt: "")
            }
        }
    }
}
